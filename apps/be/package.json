{
  "name": "@socket-poc/be",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "bun run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "start": "bun run build:ts && bun run dist/app.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "bun run --watch src/app.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "c8": "^10.1.2",
