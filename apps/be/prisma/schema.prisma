// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  username      String   @unique
  password_hash String
  nkey_seed     String
  nkey_public   String
  jwt           String
  created_at    DateTime @default(now())

  @@map("users")
}

model TradingData {
  id         Int      @id @default(autoincrement())
  timestamp  BigInt
  price      Float
  volume     Int
  symbol     String
  created_at DateTime @default(now())

  @@map("trading_data")
}
